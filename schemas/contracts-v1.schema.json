        "implementation": {
          "type": "string",
          "maxLength": 1048576
        },
        "version": {
          "type": "string",
          "maxLength": 1048576
        },
        "vocabulary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
