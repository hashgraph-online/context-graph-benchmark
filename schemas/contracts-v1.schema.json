              "type": "null"
            }
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 1048576
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "as_of": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1048576
            },
