    "label": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "cluster": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "expectation": {
          "enum": [
            "answerable",
            "unanswerable",
            "unannotated",
            "refuse"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unit"
