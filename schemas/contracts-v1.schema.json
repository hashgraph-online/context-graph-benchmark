          "maxLength": 1048576
        },
        "mode": {
          "enum": [
            "evidence",
            "graph"
          ]
        },
        "input_profile": {
          "enum": [
            "documents",
            "supplied-relationships"
          ]
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 32,
          "minItems": 1,
          "uniqueItems": true
        },
        "families": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
