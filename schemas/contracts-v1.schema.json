        "forbidden_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 100000
        },
        "mandatory_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 100000
        }
      },
      "required": [
        "task",
        "cluster",
        "expectation",
        "units",
        "expected_status",
        "forbidden_ids",
        "mandatory_ids"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 1048576
