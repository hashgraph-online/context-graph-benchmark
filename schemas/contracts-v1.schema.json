        "ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 100000
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/$defs/scope"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation",
        "documents",
        "ids",
        "scope"
      ],
      "additionalProperties": false
