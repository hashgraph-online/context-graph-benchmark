    "adapter-request": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "cgb.adapter-request.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
