            }
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "documents": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/document"
                    },
                    "maxItems": 100000
                  },
                  "ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "maxItems": 100000
                  },
                  "scope": {
                    "anyOf": [
                      {
                        "$ref": "#/$defs/scope"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "documents",
                  "ids",
                  "scope"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "set_scope"
