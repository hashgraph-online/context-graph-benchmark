      "required": [
        "id",
        "domain",
        "family",
        "query",
        "scope",
        "as_of",
        "required_ids",
        "events"
      ],
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "kind": {
          "enum": [
            "support",
            "contradiction"
          ]
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/span"
            },
            "maxItems": 128,
            "minItems": 1
          },
          "maxItems": 128,
          "minItems": 1
        }
      },
      "required": [
        "id",
        "kind",
        "alternatives"
      ],
      "additionalProperties": false
